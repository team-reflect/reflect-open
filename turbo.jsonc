{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "githubActionsRemoteBaseRefFallback": true,
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true,
  },
  "globalPassThroughEnv": ["CI", "GITHUB_ACTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["TAURI_ENV_PLATFORM"],
      "outputs": ["dist/**", ".output/**"],
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["TAURI_ENV_PLATFORM"],
      "cache": false,
      "persistent": true,
    },

    // The index wasm: cargo builds the .wasm, then wasm-bindgen writes the npm
    // package. Overriding the crate's `build` keeps the Cargo inputs, which
    // include the sources of the local crates it depends on.
    "reflect-index-wasm#build": {
      "command": [
        "cargo",
        "build",
        "--package",
        "reflect-index-wasm",
        "--target",
        "wasm32-unknown-unknown",
        "--profile",
        "wasm",
        "--locked",
      ],
      "outputs": ["$TURBO_ROOT$/target/wasm32-unknown-unknown/wasm/reflect_index_wasm.wasm"],
    },
    "@reflect/index-wasm#build": {
      "dependsOn": ["reflect-index-wasm#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/mise.toml"],
      "outputs": ["pkg/**", "!pkg/*.d.ts"],
    },
    "@reflect/index-wasm#test": {
      "dependsOn": ["build"],
    },
    "@reflect/app#test": {
      "dependsOn": ["^build"],
    },
    "@reflect/core#test": {
      "dependsOn": ["^build"],
    },
    "@reflect/web#test": {
      "dependsOn": ["^build"],
    },

    // TypeScript checks and tests (root scripts, whole repo).
    "//#lint": {
      "dependsOn": ["@reflect/index-wasm#build"],
      "outputs": [".eslintcache"],
    },
    "//#typecheck": {
      "outputs": ["**/*.tsbuildinfo"],
    },
    "//#test:node": {
      "dependsOn": ["@reflect/index-wasm#build"],
    },
    "//#test:browser": {
      "dependsOn": ["@reflect/index-wasm#build"],
      "env": ["REFLECT_TEST_BROWSER", "REFLECT_TEST_SHARD"],
      "passThroughEnv": ["VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB", "__XPC_JSC_useJIT"],
    },

    // Rust checks and tests (the whole Cargo workspace).
    "reflect-workspace#lint": {
      "command": ["cargo", "clippy", "--workspace", "--all-targets", "--locked"],
      "env": ["TAURI_CONFIG"],
      "passThroughEnv": ["ORT_CACHE_DIR"],
    },
    "reflect-workspace#lint:ios": {
      "command": [
        "cargo",
        "clippy",
        "--workspace",
        "--exclude",
        "reflect-open",
        "--all-targets",
        "--locked",
        "--target",
        "aarch64-apple-ios-sim",
      ],
      "env": ["TAURI_CONFIG"],
      "passThroughEnv": ["ORT_CACHE_DIR"],
    },
    "reflect-workspace#lint:wasm": {
      "command": [
        "cargo",
        "clippy",
        "--package",
        "reflect-index-wasm",
        "--target",
        "wasm32-unknown-unknown",
        "--locked",
      ],
      "passThroughEnv": ["AR_wasm32_unknown_unknown"],
    },
    "reflect-workspace#format:check": {
      "command": ["cargo", "fmt", "--all", "--", "--check"],
    },
    "reflect-workspace#test": {
      "env": ["TAURI_CONFIG"],
      "passThroughEnv": ["ORT_CACHE_DIR"],
    },
  },
}
