{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The Swift package, the Xcode of the runner image and the Xcode that
    // setup-xcode selects decide the results.
    "test:swift": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/actions/setup-xcode/action.yml"],
      "env": ["ImageVersion"],
      "outputs": [],
    },
    "build:ios-simulator": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/actions/setup-xcode/action.yml"],
      "env": ["ImageVersion"],
      "outputs": [],
    },
    "build:ios-device": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/actions/setup-xcode/action.yml"],
      "env": ["ImageVersion"],
      "outputs": [],
    },
  },
}
