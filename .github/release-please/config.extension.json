{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  // FIXME: for browser extension, we need to set "draft" to false.
  "draft": true,
  "force-tag-creation": true,
  "always-update": true,
  "bootstrap-sha": "11ffb9d8f627a6f42d04a4aefa83c1cb92908c79",
  "label": "autorelease: pending-extension",
  "release-label": "autorelease: tagged-extension",
  "pull-request-title-pattern": "chore(extension): release ${version}",
  // FIXME: enable "draft-pull-request" for all three release-please workflows
  "packages": {
    "apps/extension": {
      "release-type": "node",
      "package-name": "@reflect/extension",
      "component": "extension",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
