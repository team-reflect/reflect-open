{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/.wxt/**", "apps/ios/Web", "packages/index-wasm/pkg"],
  "plugins": ["typescript", "import"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "import/no-default-export": "error",
    "import/no-namespace": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "date-fns",
            "message": "Import each function from its subpath, e.g. `date-fns/addDays`. The root entry loads the types of every function."
          },
          {
            "name": "@icons-pack/react-simple-icons",
            "message": "Import each icon from its subpath, e.g. `@icons-pack/react-simple-icons/icons/SiGithub`. The root entry loads every icon."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.config.{ts,js,mjs}", "apps/extension/entrypoints/**"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/web/src/components/ui/**", "**/scripts/**"],
      "rules": {
        "import/no-namespace": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/scripts/**"],
      "rules": {
        "eslint/max-lines": "off"
      }
    }
  ]
}
