# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.eslintcache
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment secrets (never commit; use OS keychain or CI secrets)
.env
.env.*
!.env.example

# Monorepo / build caches
.turbo
/target
*.tsbuildinfo

# Reflect graph index + local state (rebuildable projection; never committed)
.reflect/

# Claude Code session artifacts (shared hooks in settings.json stay tracked)
.claude/*
!.claude/settings.json

# Vitest browser mode failure artifacts (screenshots, attachments)
.vitest-attachments/
.vitest-*/
.vitest/
__screenshots__/

# Xcode build-phase toolchain paths, generated per machine (see
# apps/desktop/src-tauri/xcode-scripts/generate-xcode-env.mjs)
.xcode.env.local

# Tauri mobile plugins (plugins/*): `.tauri` is the vendored copy of tauri's
# Swift API package that each plugin's build script recreates on every build;
# the SwiftPM/Xcode directories appear when the plugins' ios/ packages are
# built (via swift-rs) or opened in Xcode. These names are tracked nowhere in
# the repo, so they are global; `Package.resolved` IS tracked inside
# gen/apple's Xcode workspace (the Sentry pin), so the plugin copies are
# scoped by path instead.
.tauri/
.build/
.swiftpm/
xcuserdata/
DerivedData/
plugins/*/ios/Package.resolved
