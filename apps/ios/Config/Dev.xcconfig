// Configuration Debug-Dev: the dev flavor. It has its own App Group and
// shares the iCloud container with stable, so a dev build opens the same
// iCloud graphs as the Mac app.

#include "Shared.xcconfig"
#include "Debug.xcconfig"

REFLECT_FLAVOR = dev
REFLECT_BUNDLE_ID = app.reflect.ios.dev
REFLECT_DISPLAY_NAME = Reflect Dev
REFLECT_APP_GROUP = group.app.reflect.dev
REFLECT_APP_ICON = AppIcon-Dev

// The native chrome parts this flavor draws (ChromeKit `ChromeFeature`,
// separated by spaces): every part under work.
REFLECT_CHROME_FEATURES = menus
