// Configuration Release-Beta: the beta flavor. It has its own App Group and
// shares the iCloud container with stable.

#include "Shared.xcconfig"
#include "Release.xcconfig"

REFLECT_FLAVOR = beta
REFLECT_BUNDLE_ID = app.reflect.ios.beta
REFLECT_DISPLAY_NAME = Reflect Beta
REFLECT_APP_GROUP = group.app.reflect.beta
REFLECT_APP_ICON = AppIcon-Beta

// The native chrome parts this flavor draws (ChromeKit `ChromeFeature`,
// separated by spaces): the parts that passed testing on Dev.
REFLECT_CHROME_FEATURES =
