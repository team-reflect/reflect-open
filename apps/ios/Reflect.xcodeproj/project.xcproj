        { "name": "Release-Stable", "file": { "anchor": "Config", "relative-path": "Tests.xcconfig" } },
      ],
      "dependencies": [
        "Reflect",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
    }, {
