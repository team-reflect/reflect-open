    "@meowdown/react": "^0.81.2",
    "@ocavue/utils": "^1.9.0",
    "@post-embed/schema": "^0.5.2",
    "@post-embed/types": "^0.5.0",
    "@reflect/app": "workspace:*",
    "@reflect/core": "workspace:*",
    "@reflect/db": "workspace:*",
    "@reflect/design-system": "workspace:*",
    "@reflect/utils": "workspace:*",
    "@sentry/react": "^10.76.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.59.0",
    "pretty-ms": "^10.0.0",
    "react": "^19.3.1",
