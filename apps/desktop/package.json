{
  "name": "@reflect/desktop",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ios": "node scripts/build-ios.ts",
    "build:linux": "node scripts/build-installers.ts",
    "build:macos": "node scripts/build-macos.ts",
    "build:windows": "node scripts/build-installers.ts",
    "preview": "vite preview",
    "sidecar": "node scripts/build-sidecar.ts",
    "postinstall": "node src-tauri/xcode-scripts/generate-xcode-env.mjs",
    "gen:icons": "node scripts/generate-icons.ts",
    "gen:licenses": "node scripts/generate-licenses.ts",
    "release:manifest": "node scripts/release-manifest.ts",
    "upload:testflight": "node scripts/upload-testflight.ts",
    "test": "vitest run --config ../../vitest.config.ts --project desktop-browser --project desktop-node",
    "test:install": "pnpm run test:install:chromium && pnpm run test:install:webkit",
    "test:install:chromium": "playwright install chromium",
    "test:install:webkit": "playwright install webkit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:ios:dev": "tauri ios dev --config src-tauri/tauri.ios.dev.conf.json",
    "tauri:ios:dev:sim": "tauri ios dev --config src-tauri/tauri.ios.dev.conf.json \"iPhone 17 Pro\" --open",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "tauri:build:beta": "tauri build --config src-tauri/tauri.beta.conf.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
