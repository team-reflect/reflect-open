{
  "name": "@reflect/monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest",
    "lint": "pnpm run lint:oxfmt && pnpm run lint:oxlint && pnpm run lint:react",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint apps packages",
    "lint:react": "pnpm --filter @reflect/desktop lint:react",
    "fix": "pnpm run fix:oxfmt && pnpm run fix:oxlint",
    "fix:oxfmt": "oxfmt",
    "fix:oxlint": "oxlint --fix apps packages",
    "check": "pnpm typecheck && pnpm lint",
    "tauri": "pnpm --filter @reflect/desktop tauri",
    "release:ios": "pnpm --filter @reflect/desktop release:ios",
    "release:macos": "pnpm --filter @reflect/desktop release:macos",
    "release:testflight": "pnpm --filter @reflect/desktop release:ios testflight",
    "tauri:dev": "pnpm --filter @reflect/desktop tauri:dev",
    "tauri:ios:dev": "pnpm --filter @reflect/desktop tauri:ios:dev",
    "tauri:build:dev": "pnpm --filter @reflect/desktop tauri:build:dev",
    "tauri:build:beta": "pnpm --filter @reflect/desktop tauri:build:beta"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.71.0",
    "turbo": "^2.10.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
