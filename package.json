{
  "name": "@reflect/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @reflect/desktop dev",
    "build": "turbo run build",
    "build:ios": "pnpm --filter @reflect/desktop build:ios",
    "build:ffi": "node scripts/build-ffi.ts",
    "build:linux": "pnpm --filter @reflect/desktop build:linux",
    "build:macos": "pnpm --filter @reflect/desktop build:macos",
    "build:windows": "pnpm --filter @reflect/desktop build:windows",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:browser": "vitest run --project '*browser*'",
    "test:node": "vitest run --project '!*browser*'",
    "test:swift": "swift test --package-path apple",
    "lint": "pnpm run lint:oxfmt && pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:knip",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --max-warnings 0 apps packages",
    "lint:eslint": "eslint --cache --max-warnings 0",
    "lint:knip": "knip",
    "fix": "pnpm run fix:oxfmt && pnpm run fix:oxlint && pnpm run fix:eslint",
    "fix:oxfmt": "oxfmt",
    "fix:oxlint": "oxlint --max-warnings 0 --fix apps packages",
    "fix:eslint": "eslint --cache --max-warnings 0 --fix",
    "check": "pnpm typecheck && pnpm lint",
    "gen:licenses": "pnpm --filter @reflect/desktop gen:licenses",
    "tauri": "pnpm --filter @reflect/desktop tauri",
    "upload:testflight": "pnpm --filter @reflect/desktop upload:testflight",
    "tauri:dev": "pnpm --filter @reflect/desktop tauri:dev",
    "tauri:ios:dev": "pnpm --filter @reflect/desktop tauri:ios:dev",
    "tauri:ios:dev:sim": "pnpm --filter @reflect/desktop tauri:ios:dev:sim",
    "tauri:build:dev": "pnpm --filter @reflect/desktop tauri:build:dev",
    "tauri:build:beta": "pnpm --filter @reflect/desktop tauri:build:beta",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.23.0",
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "knip": "^6.44.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "simple-git-hooks": "^2.14.0",
    "tinyexec": "^1.3.1",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged --allow-empty"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.28.8"
}
