{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["TAURI_ENV_PLATFORM", "REFLECT_INDEX_WASM_PREBUILT"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "env": ["TAURI_ENV_PLATFORM", "REFLECT_INDEX_WASM_PREBUILT"],
      "cache": false,
      "persistent": true
    },
    "test": {},
    "lint": {}
  }
}
