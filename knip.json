{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreIssues": {
    "apps/desktop/src/components/ui/**": ["exports", "types"],
    "packages/db/src/schema.gen.ts": ["types"]
  },
  "workspaces": {
    ".": { "entry": ["fixtures/*.mjs"] },
    "packages/app": { "includeEntryExports": true } ,
    "packages/core": { "includeEntryExports": true } ,
    "apps/desktop": { "ignoreDependencies": ["@sentry/cli"], "ignore": "src-tauri/gen/**" },
    "apps/extension": {  "ignoreUnresolved": ["#imports"] },
    "design-system": {"ignore": "./**/*"}
  }
}
