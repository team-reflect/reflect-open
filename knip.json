{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": { "exports": "off", "types": "off" },
  "ignoreBinaries": ["swift"],
  "workspaces": {
    ".": { "entry": ["fixtures/*.mjs"] },
    "design-system": { "ignore": "./**/*" },
    "apps/ios": {
      "ignore": "Extensions/**",
      "ignoreDependencies": ["@sentry/cli", "FIXME: do we still need @sentry/cli here?"]
    }
  }
}
