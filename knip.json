{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreIssues": {
    "apps/desktop/src/components/ui/**": ["exports", "types"],
    "packages/db/src/schema.gen.ts": ["types"]
  },
  "rules": { "exports": "off", "types": "off" },
  "workspaces": {
    ".": { "entry": ["fixtures/*.mjs"] },
    "design-system": { "ignore": "./**/*" },
    "apps/desktop": {
      "ignoreDependencies": ["@sentry/cli"],
      "ignore": "src-tauri/gen/**"
    },
    "apps/extension": { "ignoreUnresolved": ["#imports"] }
  }
}
